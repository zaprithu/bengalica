---
import "../styles/global.css";
---
<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Bengalica | Centre for Bengal Studies</title>
	<link rel="icon" href="/bengalica/favicon.ico" sizes="any" />
</head>
<body>
	<header class="bg-white px-2 md:px-8 py-5 sticky top-0 z-50 shadow-md">
		<nav class="flex justify-between items-center max-w-8xl mx-auto">
			<!-- Desktop Navbar-->
			<div class="flex items-center my-auto items-center gap-4">
				<img
					src="/bengalica/images/Bengalica_icon.png"
					alt="Bengalica emblem"
					class="w-20 h-20 md:w-30 md:h-30  rounded-full object-cover border-2 border-bengalica-gold"
				/>
				<div class="mx-auto my-auto">
					<a href="/bengalica" class="font-brand text-bengalica text-3xl sm:text-4xl md:text-5xl">Bengalica</a>
					<h2 class="text-bengalica-gold  text-sm md:text-lg py-2 tracking-wide">
						Centre for Bengal Studies
					</h2>
				</div>
			</div>
			<div class="hidden md:flex">
				<ul class="flex items-center gap-30 font-sans text-xl">
					<li><a href="/" class="inline-block font-semibold text-xl text-bengalica-ink hover:text-bengalica-gold hover:scale-120 ease-in-out transition-all duration-100">Home</a></li>
					<li><a href="/about" class="inline-block font-semibold text-xl text-bengalica-ink hover:text-bengalica-gold hover:scale-120 ease-in-out transition-all duration-100">About</a></li>
					<li><a href="/articles" class="inline-block font-semibold text-xl text-bengalica-ink hover:text-bengalica-gold hover:scale-120 ease-in-out transition-all duration-100">Articles</a></li>
					<li><a href="/contact" class="inline-block font-semibold text-xl text-bengalica-ink hover:text-bengalica-gold hover:scale-120 ease-in-out transition-all duration-100">Contact</a></li>
				</ul>
			</div>
			<!-- Mobile menu button -->
			<button
				id="menu-toggle"
				type="button"
				class="md:hidden text-bengalica text-3xl p-2 hover:text-bengalica-gold hover:scale-120 ease-in-out transition-all duration-100"
				aria-label="Open navigation menu"
				aria-expanded="false"
				aria-controls="mobile-menu"
			>
				☰
			</button>

			<!-- Mobile dropdown -->
			<ul
			id="mobile-menu"
			class="hidden absolute top-full left-0 w-full bg-white shadow-lg border-t border-[#C9D0C7] flex flex-col items-center py-3 md:hidden"
			>
			<li class="w-full text-center border-b border-bengalica-dark/10">
				<a href="/bengalica/" class="block py-4 text-2xl font-semibold text-bengalica-ink hover:text-bengalica-gold hover:scale-105 ease-in-out transition-all duration-200">
				Home
				</a>
			</li>

			<li class="w-full text-center border-b border-bengalica-dark/10">
				<a href="/bengalica/about" class="block py-4 text-2xl font-semibold text-bengalica-ink hover:text-bengalica-gold hover:scale-105 ease-in-out transition-all duration-200">
				About
				</a>
			</li>

			<li class="w-full text-center border-b border-bengalica-dark/10">
				<a href="/bengalica/articles" class="block py-4 text-2xl font-semibold text-bengalica-ink hover:text-bengalica-gold hover:scale-105 ease-in-out transition-all duration-200">
				Articles
				</a>
			</li>

			<li class="w-full text-center">
				<a href="/bengalica/contact" class="block py-4 text-2xl font-semibold text-bengalica-ink hover:text-bengalica-gold hover:scale-105 ease-in-out transition-all duration-200">
				Contact
				</a>
			</li>
			</ul>
			</nav>
	</header>


	<section class="bg-bengalica py-12 px-6 text-center">

		<div class="mx-w-3xl mx-auto">

			<p class="text-white uppercase tracking-[0.25em] text-xl mb-6">
				An Independent Publication
			</p>

			<h1 class="font-brand text-white text-6xl sm:text-7xl md:text-8xl font-semibold mb-4">
				Bengalica
			</h1>

			<h2 class="text-bengalica-gold text-2xl tracking-wide mb-6">
				A Journal of Bengal Studies
			</h2>

			<p class="text-bengalica-paper text-xl leading-8 max-w-2xl mx-auto">
				A collaborative space dedicated to the research of Bengal’s history, language, thought, heritage, and affairs.
			</p>

			<div class="w-1/4 h-1 bg-white mx-auto mt-10"></div>
		</div>
	</section>

	<section class="bg-bengalica-paper px-6 py-24">
		<!--Shows one column stacked on small viewports, 2 when the screen exceeds medium breakpoint-->
		<div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-16">
			<!--Intro Column, left-->
			<div>
				<p class="text-bengalica-gold uppercase tracking-[0.2em] font-semibold mb-8">
					Areas of Research
				</p>
				
				<h2 class="font-brand text-bengalica-ink text-4xl sm:text-5xl md:text-6xl leading-tight mb-6">
					A broad view<br/>
					of Bengal
				</h2>

				<p class="text-gray-500 leading-8 max-w-sm">
					The ways that we intend on exploring Bengal's past and present.
				</p>
			</div>

			<!-- left column -->
			 <ul class="border-t border-[#C9D0C7]">

				<!-- 01: History -->
				<li class="grid grid-cols-[40px_1fr_30px] items-center gap-4 py-6 border-b border-[#C9D0C7]">
					<span class="text-bengalica text-xs">01</span>

					<div>
					<h3 class="font-brand text-bengalica-ink text-2xl font-semibold">
						History &amp; Culture
					</h3>
					<p class="text-gray-500 text-sm mt-1">
						Political, social, economic, and material histories
					</p>
					</div>

					<span class="text-bengalica text-2xl">↗</span>
				</li>

				<!-- 02: Language -->
				<li class="grid grid-cols-[40px_1fr_30px] items-center gap-4 py-6 border-b border-[#C9D0C7]">
					<span class="text-bengalica text-xs">02</span>

					<div>
					<h3 class="font-brand text-bengalica-ink text-2xl font-semibold">
						Language &amp; linguistics
					</h3>
					<p class="text-gray-500 text-sm mt-1">
						Historical linguistics, dialects, scripts, and language contact
					</p>
					</div>

					<span class="text-bengalica text-2xl">↗</span>
				</li>

				<!-- 03: Literature -->
				<li class="grid grid-cols-[40px_1fr_30px] items-center gap-4 py-6 border-b border-[#C9D0C7]">
					<span class="text-bengalica text-xs">03</span>

					<div>
					<h3 class="font-brand text-bengalica-ink text-2xl font-semibold">
						Literature &amp; Manuscripts
					</h3>
					<p class="text-gray-500 text-sm mt-1">
						Texts, authors, genres, transmission, and reception
					</p>
					</div>

					<span class="text-bengalica text-2xl">↗</span>
				</li>

				<!-- 04: Society -->
				<li class="grid grid-cols-[40px_1fr_30px] items-center gap-4 py-6 border-b border-[#C9D0C7]">
					<span class="text-bengalica text-xs">04</span>

					<div>
					<h3 class="font-brand text-bengalica-ink text-2xl font-semibold">
						Society &amp; Religion
					</h3>
					<p class="text-gray-500 text-sm mt-1">
						People, institutions, beliefs, and everyday life
					</p>
					</div>

					<span class="text-bengalica text-2xl">↗</span>
				</li>

				<!-- 05: Politics -->
				<li class="grid grid-cols-[40px_1fr_30px] items-center gap-4 py-6 border-b border-[#C9D0C7]">
					<span class="text-bengalica text-xs">05</span>

					<div>
					<h3 class="font-brand text-bengalica-ink text-2xl font-semibold">
						Politics &amp; Developments
					</h3>
					<p class="text-gray-500 text-sm mt-1">
						Current affairs, political philsophies, migration, and environment
					</p>
					</div>

					<span class="text-bengalica text-2xl">↗</span>
				</li>

			 </ul>

		</div>
	</section>


	<section class="bg-bengalica px-6 py-20">
	<div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-20 items-center">

		<!-- Left column: Heading -->
		<div>
		<p class="text-bengalica-gold uppercase tracking-[0.25em] font-semibold mb-6">
			Join our mailing list
		</p>

		<h2 class="font-brand text-white text-3xl sm:text-3xl md:text-4xl leading-tight mb-6">
			Get notified whenever the latest articles are published<br />
		</h2>

		<div class="w-20 h-1 bg-bengalica-gold"></div>
		</div>

		<!-- Right column: Description and form -->
		<div>
		<p class="text-bengalica-paper text-lg leading-8 mb-8">
			Discover new topics, explore historical perspectives, and stay
			connected with the latest research on Bengal.
		</p>

		<form class="flex flex-col sm:flex-row gap-3">
			<input
			type="email"
			name="email"
			placeholder="Your email address"
			required
			class="flex-1 min-w-0 bg-white px-5 py-4 text-bengalica-ink placeholder:text-gray-400 outline-none focus:ring-2 focus:ring-bengalica-gold"
			/>

			<button
			type="submit"
			class="bg-bengalica-gold text-bengalica-dark font-semibold px-8 py-4 transition-all duration-300 ease-in-out hover:bg-white hover:scale-105"
			>
			Subscribe
			</button>
		</form>

		<p class="text-bengalica-paper/60 text-sm mt-4">
			Cancel anytime. We respect your privacy.
		</p>
		</div>

	</div>
	</section>

	<footer class="bg-bengalica-footer text-white px-8 pt-10 pb-6">
		<div class="max-w-8xl mx-auto">

			<!-- Footer identity -->
			<div class="mb-5">
			<a href="/bengalica/" class="font-brand text-2xl tracking-widest">
				Bengalica
			</a>

			<p class="font-brand text-white/50 text-sm tracking-[0.2em] mt-1">
				Centre for Bengal Studies
			</p>
			</div>

			<!-- Divider -->
			<div class="border-t border-white/15"></div>

			<!-- Footer bottom -->
			<div class="flex flex-col md:flex-row items-center justify-between gap-5 pt-5 text-xs tracking-wide text-white/50">

			<p>
				2026 Bengalica
			</p>

			<p class="uppercase tracking-widest">
				History · Language · Culture
			</p>

			<a
				href="#top"
				class="text-white hover:text-bengalica-gold transition-colors duration-200"
			>
				Back to top ↑
			</a>

			</div>
		</div>
	</footer>

	<script>
  		import "../scripts/navigation.js";
	</script>
</body>

</html>
