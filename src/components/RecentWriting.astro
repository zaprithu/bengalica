
---
const { articles = [] } = Astro.props;

const categories = [
  "All writing",
  "History",
  "Language",
  "Literature",
  "Culture"
];
---

<section class="bg-white px-6 py-14 md:py-24">
  <div class="max-w-6xl mx-auto">

    <!-- Heading -->
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-12">
      <div>
        <p class="text-bengalica-gold uppercase tracking-[0.25em] font-semibold text-sm mb-6">
          Publications
        </p>

        <h2 class="font-brand text-bengalica-ink text-4xl sm:text-5xl md:text-6xl leading-tight">
          Recent content<span class="text-bengalica">.</span>
        </h2>
      </div>

      <p class="text-bengalica-dark/60 text-base leading-7 max-w-sm">
        Articles and essays published by the editors of Bengalica.
      </p>
    </div>

    <!-- Category toolbar and search -->
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-5 border-b border-bengalica-dark/15 pb-5 mb-8">

      <div class="flex flex-wrap items-center gap-2">
        {categories.map((category, index) => (
            <button
                type="button"
                data-category={category}
                class:list={[
                    "px-4 py-3 text-sm border transition-colors cursor-pointer",
                    index === 0
                    ? "border-bengalica text-bengalica"
                    : "border-transparent text-bengalica-dark/60 hover:text-bengalica"
                ]}
            >
                {category}
            </button>
        ))}
      </div>

      <div class="flex items-center gap-3 border-b border-bengalica-dark/20 pb-2 min-w-0 lg:w-64">
        <span class="text-bengalica text-lg">⌕</span>
        <input
          type="search"
          placeholder="Search articles"
          class="w-full bg-transparent text-sm outline-none placeholder:text-bengalica-dark/50"
        />
      </div>
    </div>

    <!-- Articles -->
    {articles.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {articles.map((article) => (
          <article>
            <a href={`/bengalica/articles/${article.slug}/`} class="group">
              <img
                src={article.image}
                alt={article.imageAlt ?? article.title}
                class="w-full aspect-[3/2] object-cover mb-6"
              />

              <p class="text-bengalica text-xs uppercase tracking-widest font-semibold mb-3">
                {article.category} · {article.readTime} min read
              </p>

              <h3 class="font-brand text-bengalica-ink text-3xl mb-3 group-hover:text-bengalica transition-colors">
                {article.title}
              </h3>

              <p class="text-bengalica-dark/60 leading-7">
                {article.excerpt}
              </p>

              <div class="border-t border-bengalica-dark/15 mt-6 pt-4 flex justify-between items-center">
                <span class="text-sm text-bengalica-dark">
                  {article.author}
                </span>
                <span class="text-bengalica text-xl">↗</span>
              </div>
            </a>
          </article>
        ))}
      </div>
    ) : (
      <div class="py-20 md:py-28 text-center">
        <p class="text-bengalica-gold uppercase tracking-[0.25em] text-sm font-semibold mb-5">
          The Editorial Desk
        </p>

        <h3 class="font-brand text-bengalica-ink text-4xl md:text-5xl mb-5">
          Coming soon<span class="text-bengalica">.</span>
        </h3>

        <p class="text-bengalica-dark/60 leading-8 max-w-lg mx-auto">
          We are preparing our first collection of articles. Our publication will begin soon.
        </p>

        <div class="w-1/3 h-px bg-bengalica-gold mx-auto mt-10"></div>
      </div>
    )}

  </div>
</section>

<script>
  const categoryButtons = document.querySelectorAll("[data-category]");

  categoryButtons.forEach((button) => {
    button.addEventListener("click", () => {

      // Remove the active styling from every button
      categoryButtons.forEach((item) => {
        item.classList.remove("border-bengalica", "text-bengalica");
        item.classList.add("border-transparent", "text-bengalica-dark/60");
      });

      // Apply active styling to the clicked button
      button.classList.remove("border-transparent", "text-bengalica-dark/60");
      button.classList.add("border-bengalica", "text-bengalica");
    });
  });
</script>
